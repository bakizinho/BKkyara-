/**
 * KYARA CORE
 *
 * Camada de organização entre WhatsApp/Core e a IA existente.
 *
 * IMPORTANTE:
 * Este arquivo NÃO substitui ia.js.
 * O motor original continua sendo responsável pela geração da resposta.
 */

import { KYARA_PERSONA } from './persona.js';
import { entenderIntencao } from './orquestrador.js';
import {
  montarContexto,
  extrairTextoMensagem
} from './contexto.js';

export async function kyaraCore({
  mensagem = {},
  ia,
  nazu = null,
  ownerNumber = null,
  personality = 'humana',
  customPrompt = null,
  memoria = null
} = {}) {

  if (!ia || typeof ia.makeAssistentRequest !== 'function') {
    throw new Error(
      '[KYARA CORE] Motor ia.makeAssistentRequest não está disponível'
    );
  }

  const texto = extrairTextoMensagem(mensagem);

  if (!texto) {
    return {
      resposta: null,
      intencao: 'VAZIO',
      persona: KYARA_PERSONA.nome
    };
  }

  const intencao = entenderIntencao(texto);

  const contexto = montarContexto({
    mensagem,
    intencao,
    persona: KYARA_PERSONA,
    memoria
  });

  /*
   * A IA ORIGINAL continua recebendo o formato que ela já conhece.
   *
   * Não alteramos processUserMessages().
   * Não alteramos ia.js.
   */

  const resposta = await ia.makeAssistentRequest(
    {
      mensagens: [mensagem],
      contextoKyara: contexto
    },
    nazu,
    ownerNumber,
    personality,
    customPrompt
  );

  return {
    resposta,
    intencao,
    persona: KYARA_PERSONA.nome,
    contexto
  };
}

export default kyaraCore;
