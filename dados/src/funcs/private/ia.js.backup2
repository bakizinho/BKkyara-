import axios from 'axios';
import crypto from 'crypto';
import userContextDB from '../../utils/userContextDB.js';

// ============================================================================
// KYARA CORE — LOCAL AI
// ============================================================================

const LOCAL_AI_URL = 'http://127.0.0.1:8080';
const LOCAL_AI_MODEL = 'qwen2.5-0.5b-instruct-q4_k_m.gguf';
const LOCAL_AI_ENDPOINT = '/completion';

// O modelo é pequeno e roda no CPU.
// Por isso mantemos prompts e respostas curtos.
const AI_TIMEOUT = 90000;
const AI_MAX_TOKENS = 40;
const AI_TEMPERATURE = 0.75;

let historico = {};
let conversationStates = {};
let userPreferences = {};
let userInteractions = {};

// ============================================================================
// DATA / HORA
// ============================================================================

function getBrazilDateTime() {
  return new Date().toLocaleString('sv-SE', {
    timeZone: 'America/Sao_Paulo'
  }).replace(' ', 'T') + '-03:00';
}

// ============================================================================
// COMPATIBILIDADE
// ============================================================================

function updateApiKeyStatus() {
  return true;
}

function getApiKeyStatus() {
  return {
    isValid: true,
    provider: 'local',
    online: true
  };
}

